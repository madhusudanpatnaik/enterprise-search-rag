# entsearch — copy to .env, fill in what you use, then: set -a; . ./.env; set +a
# --generate anthropic (the grounded-answer generator):
ANTHROPIC_API_KEY=
# Optional: higher Hugging Face rate limits for `entsearch download`
HF_TOKEN=
# Optional: where downloaded models live (default ~/.cache/huggingface)
HF_HOME=
